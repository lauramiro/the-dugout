# Names only. Put real values in .env, never in this file.

# Foundry resource endpoint, e.g. https://<resource>.openai.azure.com or https://<resource>.services.ai.azure.com
FOUNDRY_ENDPOINT=
# Key for that resource
FOUNDRY_API_KEY=
# Model deployment name (the deployed narration model is gpt-5-mini)
FOUNDRY_MODEL=
# Optional reasoning effort for gpt-5 family models; minimal keeps a call under the 3 s timeout
FOUNDRY_REASONING_EFFORT=
